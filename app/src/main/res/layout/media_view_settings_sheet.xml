<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/apply_all_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/media_view_apply_all" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/media_view_section_view"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/view_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/media_view_list" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/media_view_grid" />

    </RadioGroup>

    <LinearLayout
        android:id="@+id/columns_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/media_view_columns"
            android:textSize="15sp" />

        <Button
            android:id="@+id/columns_minus"
            style="?attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="−"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/columns_value"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp" />

        <Button
            android:id="@+id/columns_plus"
            style="?attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="＋"
            android:textSize="18sp" />

    </LinearLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/show_names_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/media_view_show_names" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/media_sort_section"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/sort_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:padding="12dp"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/media_view_section_other"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/show_hidden_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/media_view_show_hidden" />

</LinearLayout>
